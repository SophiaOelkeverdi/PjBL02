{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run pjBL2",
      "type": "shell",
      "command": "\"${workspaceFolder}/run.sh\" pjBL2.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run current Python file on host",
      "type": "shell",
      "command": "\"${workspaceFolder}/run.sh\" \"${file}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
