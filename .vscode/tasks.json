{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run pjBL2",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "args": ["pjbl02_spark.py"],
      "windows": {
        "command": "${workspaceFolder}\\run.cmd",
        "args": ["pjbl02_spark.py"],
        "options": {
          "cwd": "${workspaceFolder}",
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run current Python file on host",
      "type": "shell",
      "command": "${workspaceFolder}/run.sh",
      "args": ["${file}"],
      "windows": {
        "command": "${workspaceFolder}\\run.cmd",
        "args": ["${file}"],
        "options": {
          "cwd": "${workspaceFolder}",
          "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
